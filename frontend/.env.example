# Base de la API REST. Vacío = mismo origen (usa el proxy de Vite en desarrollo).
VITE_API_URL=
# Base del WebSocket de jobs. Vacío = mismo origen.
VITE_WS_URL=
# Backend al que el proxy de Vite redirige /api y /ws en desarrollo.
VITE_PROXY_TARGET=http://localhost:8000
# true = responde /api con datos de ejemplo (MSW), sin backend.
VITE_USE_MOCKS=false
# true = inicia sesión automáticamente con la cuenta de prueba. Solo tiene efecto si VITE_USE_MOCKS=true.
VITE_AUTO_LOGIN=false
