# Origen del frontend: redirect_uri de GitHub ({FRONTEND_URL}/github/callback) y CORS.
FRONTEND_URL=http://localhost:5173

# Opcionales: si quedan vacías, el backend las genera al arrancar y las guarda en data/secrets.json.
# Firma de los tokens de sesión de la app.
SECRET_KEY=
# Cifrado de los tokens de GitHub guardados (clave Fernet).
TOKEN_ENCRYPTION_KEY=

# OAuth App de GitHub (https://github.com/settings/developers → New OAuth App)
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base de datos SQLite
DATABASE_PATH=data/ia_voy.db

# Carpeta de los repos clonados. Vacía = %LOCALAPPDATA%\ia-voy\repos (o ~/.cache/ia-voy/repos).
# Evita carpetas sincronizadas (OneDrive, Dropbox): bloquean los archivos recién clonados.
CLONES_PATH=

# Pausa antes de crear el entorno cuando no hay sandbox (la terminal alcanza a mostrar el paso)
JOB_STEP_SECONDS=0.9

# Dónde se crea el entorno aislado (paso 2 del análisis):
#   off    = en el backend con python -m venv (no necesita nada más)
#   wsl    = WSL2 con uv (ver README §2.1). Aísla del entorno de Windows pero no del disco (/mnt/c)
#   docker = contenedor desechable con el clon de solo lectura (requiere Docker Desktop corriendo)
SANDBOX=off
SANDBOX_WSL_DISTRO=Ubuntu-24.04
