# Origen del frontend: redirect_uri de GitHub ({FRONTEND_URL}/github/callback) y CORS.
FRONTEND_URL=http://localhost:5173

# Opcionales: si quedan vacías, el backend las genera al arrancar y las guarda en data/secrets.json.
# Firma de los tokens de sesión de la app.
SECRET_KEY=
# Cifrado de los tokens de GitHub guardados (clave Fernet).
TOKEN_ENCRYPTION_KEY=

# OAuth App de GitHub (https://github.com/settings/developers → New OAuth App)
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/github/callback
# No subir los valores reales al repositorio.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base de datos SQLite
DATABASE_PATH=data/ia_voy.db

# Carpeta de los repos clonados. Vacía = %LOCALAPPDATA%\ia-voy\repos (o ~/.cache/ia-voy/repos).
# Evita carpetas sincronizadas (OneDrive, Dropbox): bloquean los archivos recién clonados.
CLONES_PATH=

# Pausa por paso en la terminal del análisis (11 pasos)
JOB_STEP_SECONDS=0.9

# Dónde corren pytest, coverage y pip-audit (ejecutan el código del repo analizado):
#   off    = simulados (marcados "(simulado)" en el reporte)
#   wsl    = WSL2 con uv (ver backend/README.md). Aísla del entorno de Windows pero no del disco (/mnt/c): para repos propios
#   docker = contenedor desechable con el clon de solo lectura (requiere Docker Desktop corriendo): para repos ajenos
SANDBOX=off
SANDBOX_WSL_DISTRO=Ubuntu-24.04

# Asistente IA. Clave de Gemini (respuestas y embeddings): https://aistudio.google.com/apikey
# Sin ella el resto de la app funciona; el asistente responde 503 llm_not_configured.
GEMINI_API_KEY=
# Opcional. gemini-2.5-flash ya no está disponible para claves nuevas.
#GEMINI_MODEL=gemini-3.8-flash
